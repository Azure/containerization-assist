# Multi-stage build for .NET application (Windows)
# Uses Windows-based images instead of Alpine

# Build stage - compile the application
FROM mcr.microsoft.com/dotnet/sdk:8.0-nanoserver-ltsc2022 AS builder

WORKDIR /app

# Copy project file first for better layer caching
COPY *.csproj ./

# Restore dependencies (separate layer for caching)
RUN dotnet restore

# Copy source files
COPY . .

# Build release version
RUN dotnet publish -c Release -o /app/publish --no-restore

# Runtime stage - use ASP.NET runtime only
FROM mcr.microsoft.com/dotnet/aspnet:8.0-nanoserver-ltsc2022 AS runtime

WORKDIR /app

# Copy published output from builder
COPY --from=builder /app/publish .

# Expose port
EXPOSE 8080

# Set ASP.NET environment
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Build args for metadata
ARG VERSION=1.0.0
LABEL version=${VERSION}

# Start application
ENTRYPOINT ["dotnet", "BuildTestApp.dll"]
